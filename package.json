{
  "name": "duoyu-extension",
  "description": "多鱼新标签页",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check",
    "postinstall": "wxt prepare",
    "test:search": "node scripts/search-regression.mjs",
    "test:engines": "node scripts/engine-wheel.mjs",
    "test:wallpaper": "node scripts/wallpaper-cache.mjs",
    "test:workspace": "node scripts/review-regression.mjs workspace-interactions-ui workspace-crud-current workspace-collections",
    "test:workspace-collections": "node scripts/workspace-collections.mjs",
    "test:workspace:crud": "node scripts/workspace-crud-current.mjs",
    "test:review": "node scripts/review-regression.mjs",
    "test:linux": "node scripts/linux-release.mjs",
    "test:restore": "node scripts/restore-drill.mjs",
    "test:import:race": "node scripts/import-dialog-race.mjs",
    "test:library": "node scripts/review-regression.mjs library-crud-ui library-grid library-page-icons library-page-context library-page-reorder library-page-drag folder-pagination-ui",
    "test:widgets": "node scripts/review-regression.mjs desktop-layout desktop-selection resize-push library-limits desktop-interactions-ui",
    "test:shortcuts": "node scripts/shortcuts.mjs",
    "test:radial": "node scripts/radial-wheel.mjs",
    "test:widget-links": "node scripts/review-regression.mjs folder-auto-sort folder-drag-out folder-entry-direction dock-links",
    "test:glass": "node scripts/review-regression.mjs local-backdrop offline-contrast-ui workspace-interactions-ui",
    "test:auth": "node scripts/auth-protocol.mjs",
    "test:admin:api": "node scripts/admin-api-regression.mjs",
    "test:admin:management-race": "node scripts/admin-management-race.mjs",
    "test:website-icon": "node scripts/website-icon.mjs",
    "test:auth:integration": "node scripts/auth-isolated.mjs",
    "test:auth:isolated": "node scripts/auth-isolated.mjs",
    "test:id:pages": "node scripts/auth-isolated.mjs --id-pages",
    "test:id:role-race": "node scripts/id-role-race.mjs",
    "test:id:management-race": "node scripts/id-management-race.mjs",
    "test:id:security": "node scripts/auth-isolated.mjs --id-security",
    "test:admin:isolated": "node scripts/auth-isolated.mjs --admin-pages",
    "test:browser:compatibility": "node scripts/browser-compatibility-ui.mjs",
    "test:workspace:stability": "node scripts/workspace-stability-ui.mjs",
    "test:cloud:client": "node scripts/cloud-client.mjs",
    "test:cloud:integration": "node scripts/cloud-integration.mjs",
    "test:cloud:server": "corepack pnpm@11.25.0 --dir ../DuoYu-Backend/server/sync test",
    "test:cloud:ui": "node scripts/cloud-ui.mjs",
    "test:cloud:account-ui": "node scripts/cloud-account-ui.mjs",
    "test:conflict-preview": "node scripts/conflict-preview.mjs",
    "build:admin": "corepack pnpm@11.25.0 --dir ../DuoYu-Backend/admin build",
    "test:admin:ui": "corepack pnpm@11.25.0 --dir ../DuoYu-Backend test:admin:ui",
    "test:cloud:assets": "node scripts/asset-lifecycle.mjs",
    "test:upload:ui": "node scripts/upload-lifecycle-ui.mjs",
    "test:data-integrity": "node scripts/data-integrity.mjs",
    "test:library:crud": "node scripts/library-crud-ui.mjs",
    "test:desktop:interactions": "node scripts/desktop-interactions-ui.mjs",
    "test:folder:dialog": "node scripts/folder-dialog-ui.mjs"
  },
  "dependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "dexie": "^4.4.6",
    "gridstack": "^14.0.0",
    "jose": "^6.2.13",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  }
}
