{
  "name": "duoyu-extension",
  "description": "多鱼新标签页",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check",
    "postinstall": "wxt prepare",
    "test:search": "node scripts/search-regression.mjs",
    "test:engines": "node scripts/engine-wheel.mjs",
    "test:wallpaper": "node scripts/wallpaper-cache.mjs",
    "test:workspace": "node scripts/workspace.mjs",
    "test:workspace-collections": "node scripts/workspace-collections.mjs",
    "test:library": "node scripts/library.mjs",
    "test:widgets": "node scripts/widgets.mjs",
    "test:shortcuts": "node scripts/shortcuts.mjs",
    "test:radial": "node scripts/radial-wheel.mjs",
    "test:widget-links": "node scripts/widget-links.mjs",
    "test:glass": "node scripts/glass.mjs",
    "test:auth": "node scripts/auth-protocol.mjs",
    "test:auth:integration": "node scripts/auth-integration.mjs",
    "test:cloud:client": "node scripts/cloud-client.mjs",
    "test:cloud:integration": "node scripts/cloud-integration.mjs",
    "test:cloud:server": "corepack pnpm@11.25.0 --dir ../DuoYu-Backend/server/sync test",
    "test:cloud:ui": "node scripts/cloud-ui.mjs",
    "test:cloud:account-ui": "node scripts/cloud-account-ui.mjs",
    "test:conflict-preview": "node scripts/conflict-preview.mjs",
    "build:admin": "corepack pnpm@11.25.0 --dir ../DuoYu-Backend/admin build",
    "test:admin:ui": "corepack pnpm@11.25.0 --dir ../DuoYu-Backend test:admin:ui",
    "test:cloud:assets": "node scripts/asset-lifecycle.mjs",
    "test:upload:ui": "node scripts/upload-lifecycle-ui.mjs"
  },
  "dependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "dexie": "^4.4.6",
    "gridstack": "^14.0.0",
    "jose": "^6.2.13",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  }
}
