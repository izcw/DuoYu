[Unit]
Description=DuoYu cloud synchronization API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duoyu-sync
Group=duoyu-sync
WorkingDirectory=/www/wwwroot/duoyu-sync
EnvironmentFile=/www/server/duoyu-sync.env
ExecStart=/bin/node /www/wwwroot/duoyu-sync/src/main.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
